#ifndef COLLISIONCONSTRAINT_H
#define COLLISIONCONSTRAINT_H

#include <osgManipulator/Constraint>
#include <osgManipulator/Dragger>
#include <osgManipulator/Selection>

#include <osgVirtualAssembly/Exports>

namespace osgVirtualAssembly
{

class OSGVIRTUALASSEMBLY_EXPORT CollisionConstraint : public osgManipulator::Constraint
{
public:
	
	CollisionConstraint(osgManipulator::Dragger* dragger);
	
	virtual bool constrain(osgManipulator::TranslateInLineCommand& command) const;
	virtual bool constrain(osgManipulator::TranslateInPlaneCommand& command) const;
	virtual bool constrain(const osgManipulator::Rotate3DCommand& command);

	virtual void start() const;

	virtual bool handleCommand(osgManipulator::MotionCommand& command) const;

protected:

	virtual ~CollisionConstraint();

	osg::observer_ptr<osgManipulator::Dragger> _dragger;
};

}
#endif