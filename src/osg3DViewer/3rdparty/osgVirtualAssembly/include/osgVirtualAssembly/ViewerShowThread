#ifndef VIEWERSHOWTHREAD_H
#define VIEWERSHOWTHREAD_H

#include <OpenThreads/Thread>
#include <osg/ref_ptr>
#include <osgViewer/ViewerBase>

#include <QApplication>

#include <osgVirtualAssembly/Exports>


namespace osgVirtualAssembly
{

class OSGVIRTUALASSEMBLY_EXPORT ViewerShowThread : public OpenThreads::Thread
{
public:

	ViewerShowThread(osgViewer::ViewerBase* viewerBase, bool doQApplicationExit):
	  _viewerBase(viewerBase),
		  _doQApplicationExit(doQApplicationExit) {}

	  ~ViewerShowThread()
	  {
		  cancel();
		  while(isRunning())
		  {
			  OpenThreads::Thread::YieldCurrentThread();
		  }
	  }

	  int cancel()
	  {
		  _viewerBase->setDone(true);
		  return 0;
	  }

	  void run()
	  {
		  int result = _viewerBase->run();

		 // if (_doQApplicationExit) QApplication::exit(result);
	  }

protected:
	  osg::ref_ptr<osgViewer::ViewerBase> _viewerBase;
	  bool _doQApplicationExit;
};

}
#endif