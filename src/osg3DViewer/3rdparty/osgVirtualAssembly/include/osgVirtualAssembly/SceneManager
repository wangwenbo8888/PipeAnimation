#ifndef SCENEMANAGER_H
#define SCENEMANAGER_H

#include <osg/observer_ptr>
#include <osg/Referenced>
#include <osg/MatrixTransform>

#include <osgViewer/Viewer>

#include <osgDragger/SceneManipulator>

#include <osgVirtualAssembly/PickSelectionHandler>

#include <osgDragger/HudCamera>
#include <osgDragger/HudDraggerCamera>

#include <Utils/Utils>
#include <osgVirtualAssembly/Exports>


namespace osgVirtualAssembly
{

class OSGVIRTUALASSEMBLY_EXPORT SceneManager : public osg::Referenced
{
public:
	
	static SceneManager* Instence();

	virtual void initScene(osg::Node* node, StringList& SL);

	void setDirty(bool dirty){ _dirty = dirty; }

	osgViewer::Viewer* getViewer(){ return _viewer.get(); }
	
	PickSelectionHandler* getPickHandler(){ return _pickHandler.get(); }

	virtual void onDestroy()
	{ 
		_viewer->stopThreading();

		_viewer = 0;
	}
protected:

	SceneManager();
	virtual ~SceneManager();

	virtual void init();

	osg::ref_ptr<osgViewer::Viewer> _viewer;

	osg::ref_ptr<osg::Group> _root;

	osg::ref_ptr<osg::MatrixTransform> _scene;

	osg::observer_ptr<osg::Geode> _debugGeode;

	osg::observer_ptr<PickSelectionHandler> _pickHandler;

	osg::ref_ptr<osgDragger::HudCamera> _hudCamera;

	osg::ref_ptr<osgDragger::HudDraggerCamera> _hudDraggerCamera;

	bool _dirty;
	bool _init;

	//TestUi testUI;

};

}
#endif