	};

	typedef TemplateMoveDragger<osgManipulator::Translate1DDragger, osgManipulator::Translate2DDragger> MoveDragger;
	
	typedef TemplateRotateDragger<osgManipulator::RotateCylinderDragger, osgManipulator::RotateSphereDragger> RotateDragger;
}

